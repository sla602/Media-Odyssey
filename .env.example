# Application settings
PORT=8080
SESSION_COOKIE_SECURE=FALSE
REMEMBER_ME_KEY=change-me
# Local app runs use project-root logs by default. Compose maps host logs to this container path.
ACCESS_LOG_HOST_DIRECTORY=./logs
ACCESS_LOG_CONTAINER_DIRECTORY=/logs

# Development mode settings
DEV_MODE=FALSE
DEV_MODE_ROLE=
DEV_EMAIL_SUFFIX=

# GitHub Container Registry (GHCR)
GHCR_IMAGE=ghcr.io/sla602/media-odyssey:main

# Database used by Docker compose
POSTGRES_DB=media_odyssey
POSTGRES_USER=media_odyssey
POSTGRES_PASSWORD=change-me

# Spring datasource values. If running with Database used by Docker compose, username and password should match POSTGRES_USER and POSTGRES_PASSWORD, and URL should point to the DB service.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/media_odyssey
SPRING_DATASOURCE_USERNAME=media_odyssey
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_SCHEMA=public

# Cloudflare Tunnel
CLOUDFLARED_TUNNEL_TOKEN=

# Media APIs
TMDB_API_KEY=
RAWG_API_KEY=
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Backblaze B2 / S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
STORAGE_REGION=

# Email
EMAIL_FROM=
VERIFY_TOKEN_EXPIRY_IN_MINUTES=60
RESET_TOKEN_EXPIRY_IN_MINUTES=30
RESEND_API_KEY=

# OIDC - Google
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
