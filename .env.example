# Application & Server
PORT=8080
SESSION_COOKIE_SECURE=FALSE
REMEMBER_ME_KEY=change-me
DEV_MODE=FALSE
DEV_EMAIL_SUFFIX=

# Docker Container Registry
GHCR_IMAGE=ghcr.io/sla602/media-odyssey:main

# Database used by docker compose
POSTGRES_DB=media_odyssey
POSTGRES_USER=media_odyssey
POSTGRES_PASSWORD=change-me

# Spring datasource values injected into the app container
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/media_odyssey
SPRING_DATASOURCE_USERNAME=media_odyssey
SPRING_DATASOURCE_PASSWORD=change-me

# Cloudflare Tunnel
CLOUDFLARED_TUNNEL_TOKEN=

# Media APIs
TMDB_API_KEY=
RAWG_API_KEY=
LASTFM_API_KEY=
LASTFM_API_SECRET=

# Backblaze B2 / S3-compatible storage
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_PUBLIC_URL=
STORAGE_REGION=

# Email
EMAIL_FROM=
VERIFY_TOKEN_EXPIRY_IN_MINUTES=60
RESET_TOKEN_EXPIRY_IN_MINUTES=30
RESEND_API_KEY=

# OAuth
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=